# =============================================================================
# Frota SENAI — variáveis de ambiente (Docker / Debian on-premises)
#
# No servidor:
#   [ -f .env ] || cp .env.example .env
#   nano .env   # preencha os valores; NÃO versione o .env
# =============================================================================

# --- Segurança Django --------------------------------------------------------
# Gere chaves fortes (não reutilize estes placeholders):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# HMAC da cadeia de auditoria. Defina explicitamente e NÃO altere depois
# da primeira instalação com dados. Se omitida, usa SECRET_KEY.
AUDITORIA_CHAVE_INTEGRIDADE=troque-por-chave-auditoria-estavel

DEBUG=False

# Hostnames SEM esquema. Inclua o hostname ou IP pelo qual os usuários acessam.
# Mantenha localhost e 127.0.0.1 (healthcheck do container backend).
# Ex.: localhost,127.0.0.1,frota.senai.local,10.0.0.50
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens COM esquema (Django Admin / CSRF). Mesmo host do navegador.
# Ex.: http://localhost,http://10.0.0.50,https://frota.senai.local
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Com SPA e API no mesmo host (Nginx), liste a origem pública.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOW_LAN=False

# Atrás do Nginx no Compose: True.
USE_X_FORWARDED_HOST=True
# True apenas se houver TLS terminado no proxy e X-Forwarded-Proto=https.
SECURE_PROXY_SSL_HEADER=False

# --- Banco PostgreSQL (Compose sobrescreve HOST/PORT para db:5432) -----------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=frota
DB_USER=frota
DB_PASSWORD=troque-por-senha-forte-do-banco
DB_HOST=db
DB_PORT=5432
# Rede interna Docker: disable. Conexões externas com SSL: require.
DB_SSLMODE=disable
# PostgreSQL direto (Docker): False. Pooler Supabase: True.
DB_DISABLE_SERVER_SIDE_CURSORS=False

# --- Armazenamento -----------------------------------------------------------
# False = disco local (volume Docker media). Não use S3/Supabase no Compose mínimo.
USE_SUPABASE_STORAGE=False

# --- Frontend (build-time; embutido na imagem Nginx) -------------------------
# Mesmo host: /api. Não use http://localhost:8000 no navegador.
VITE_API_URL=/api

# --- Compose -----------------------------------------------------------------
# Porta HTTP no host (Nginx). Use 8080 se a 80 estiver ocupada.
HTTP_PORT=80

# --- E-mail complementar (desligado por padrão) ------------------------------
# Não ative sem autorização da TI. Não invente credenciais.
# FROTA_EMAIL_ENABLED=False
# EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=frota@senai.local
