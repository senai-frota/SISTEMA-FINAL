# Desenvolvimento / Render / Supabase.
# Para Docker no Debian use o .env na raiz do projeto FROTA/ (veja ../.env.example).
# Não copie este arquivo como .env do Compose.

SECRET_KEY=change-me-in-production
DEBUG=True

# Chave HMAC que sela a cadeia da auditoria. Default = SECRET_KEY.
# Use um valor longo (32+ caracteres), secreto e ESTÁVEL: trocá-la faz todos os
# registros antigos aparecerem como inválidos na verificação de integridade.
# AUDITORIA_CHAVE_INTEGRIDADE=

# Tamanho máximo (MB) da imagem de referência do veículo. Default 5.
# VEICULO_IMAGEM_TAMANHO_MAXIMO_MB=5
# Número máximo de fotos por veículo. Default 8.
# VEICULO_IMAGEM_MAXIMO_FOTOS=8

# Produção (Render): liste o hostname do backend.
# Desenvolvimento: com DEBUG=True o código usa ALLOWED_HOSTS=['*'] para LAN.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens explícitas do frontend.
# Dev: localhost. Produção: URL pública do frontend no Render.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Permite frontend acessado pelo IP da LAN (ex.: http://192.168.x.x:5173)
# sem cadastrar cada IP. Default = DEBUG. Em produção no Render deixe False
# ou omita (DEBUG=False já desliga).
# CORS_ALLOW_LAN=True

# Banco de Dados (Supabase / PostgreSQL - Connection Pooling / Transaction mode)
# Pegue esses valores em: Supabase Dashboard > Project Settings > Database > Connection pooling
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=sua-senha-do-banco
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=6543

# Storage de uploads (CNH, termos, vistorias).
# False = disco local (MEDIA_ROOT). True = bucket S3 do Supabase
# (recomendado com banco remoto compartilhado).
USE_SUPABASE_STORAGE=False
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_BUCKET_NAME=
# SUPABASE_S3_ENDPOINT_URL=https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=sa-east-1
# SUPABASE_S3_URL_EXPIRE=3600
